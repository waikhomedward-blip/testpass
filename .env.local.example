# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# --- Supabase (Project Settings → API) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# service_role key (NOT the anon key) — server-only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=

# --- Stripe (see src/lib/stripe.ts) ---
# Test-mode keys first (dashboard.stripe.com/test/apikeys). Leave blank to
# keep checkout disabled (the "Stripe isn't connected yet" path).
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in the Stripe dashboard pointing at
# https://<your-domain>/api/stripe/webhook (or via `stripe listen` for
# local testing).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYWALL_ENABLED=false
# In cents. $5.00 is the initial pricing hypothesis, not a commitment —
# change this rather than editing code to try a different price.
RESULT_PRICE_AMOUNT=500
RESULT_PRICE_CURRENCY=usd

# --- Retention cleanup (see src/app/api/cleanup/route.ts, vercel.json) ---
# Any long random string. Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` on scheduled cron requests when an
# env var named exactly CRON_SECRET is set — this is what makes the
# cleanup route unreachable by anyone else.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
